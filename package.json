{
  "name": "rest",
  "version": "1.0.0",
  "description": "A Filament API application",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "mkdir -p dist/data/schema && cp -r src/data/schema/* dist/data/schema/ && cp src/data/queries.yaml dist/data/queries.yaml",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --experimental-test-coverage tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "generate": "tsx src/data/generator/index.ts",
    "type-check": "tsc --noEmit",
    "depcheck": "depcheck",
    "docker:build": "docker build -t rest .",
    "docker:run": "docker run -p 3000:3000 rest",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@filamentjs/rate-limiting": "^0.1.1",
    "@filamentjs/request-logging": "^0.1.0",
    "args-and-envs": "^0.4.3",
    "filamentjs": "^0.6.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "safe-stable-stringify": "^2.5.0",
    "toml": "^5.0.0",
    "winston": "^3.19.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.0.0",
    "get-port": "^7.1.0",
    "lint-staged": "^15.2.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.2.4",
    "test-battery": "^3.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true
  }
}
